function toNumber(value){if(value===null||value===undefined||value==="")return 0;return Number(String(value).replace(",","."))}
function ensureSheet(){var sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Einträge");if(!sheet)sheet=SpreadsheetApp.getActiveSpreadsheet().insertSheet("Einträge");if(sheet.getLastRow()===0){sheet.appendRow(["Erfasst am","Zeitraum von","Zeitraum bis","Maschine","Name / Fahrer","Stundenzähler Beginn","Stundenzähler Ende","Gefahrene Stunden","Diesel Liter","Einsatzart","Getankt","Bemerkung"])}return sheet}
function doPost(e){var sheet=ensureSheet();var data=JSON.parse(e.postData.contents);var start=toNumber(data.stundenStart);var ende=toNumber(data.stundenEnde);var gefahreneStunden=Math.round((ende-start)*100)/100;if(gefahreneStunden<0)gefahreneStunden=0;sheet.appendRow([new Date(),data.datumVon||"",data.datumBis||"",data.maschine||"TB290",data.name||"",start,ende,gefahreneStunden,toNumber(data.diesel),data.einsatzart==="ueberbetrieblich"?"überbetrieblich":"innerbetrieblich",data.getankt?"Ja":"Nein",data.bemerkung||""]);return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON)}
function doGet(e){var action=e&&e.parameter?e.parameter.action:"";if(action==="last"){var sheet=ensureSheet();if(sheet.getLastRow()<2){return ContentService.createTextOutput(JSON.stringify({ok:true,lastEnde:""})).setMimeType(ContentService.MimeType.JSON)}var lastRow=sheet.getLastRow();var lastEnde=sheet.getRange(lastRow,7).getValue();return ContentService.createTextOutput(JSON.stringify({ok:true,lastEnde:lastEnde})).setMimeType(ContentService.MimeType.JSON)}return ContentService.createTextOutput("TB290 Erfassung ist aktiv.").setMimeType(ContentService.MimeType.TEXT)}